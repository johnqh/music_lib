{
  "name": "@sudobility/music_lib",
  "version": "1.9.67",
  "description": "Platform-free business logic for ScoreSmith: domain services, generation, persistence rules, and preferences",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "music",
    "scoresmith",
    "notation",
    "midi",
    "musicxml",
    "vexflow",
    "tone"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/music_types": "^0.13.41",
    "immer": "^10.0.0 || ^11.0.0",
    "zustand": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@sudobility/music_types": "^0.13.41",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "ajv": "^8",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.4.0",
    "immer": "^10.0.0 || ^11.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15",
    "zustand": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnqh/music_lib.git"
  }
}
