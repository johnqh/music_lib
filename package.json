{
  "name": "@sudobility/music_lib",
  "version": "0.3.5",
  "description": "Business logic for ScoreSmith: score domain model, commands/undo, validation, quantization, rendering/audio/file adapters, and the app store",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "music",
    "scoresmith",
    "notation",
    "midi",
    "musicxml",
    "vexflow",
    "tone"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "dexie": "^4.0.0",
    "immer": "^10.0.0 || ^11.0.0",
    "tone": "^15.0.0",
    "vexflow": "^4.2.5",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=5",
    "@tanstack/react-query": ">=5",
    "@sudobility/music_client": "^0.1.1",
    "@sudobility/music_types": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tanstack/react-query": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.4.0",
    "jsdom": "^29.0.0",
    "react": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "zustand": "^5.0.0",
    "@sudobility/music_client": "^0.1.1",
    "@sudobility/music_types": "^0.1.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnqh/music_lib.git"
  }
}
